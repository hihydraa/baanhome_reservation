generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  STAFF
  HOUSEKEEPER
}

enum ResourceZone {
  RESORT
  POOL_VILLA
  BANQUET
}

enum ResourceType {
  ACCOMMODATION
  BANQUET
}

enum HousekeepingStatus {
  READY
  NEEDS_CLEANING
  OUT_OF_SERVICE
}

enum BookingSource {
  WALK_IN
  AGODA
  PHONE
  LINE_OA
  OTHER
}

enum AccommodationStatus {
  RESERVED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

enum BanquetEventType {
  MEETING
  BANQUET
  SEMINAR
  OTHER
}

enum BanquetStatus {
  RESERVED
  CONFIRMED
  CANCELLED
}

enum PaymentMethod {
  CASH
  TRANSFER
  CREDIT_CARD
}

enum BookingType {
  ACCOMMODATION
  BANQUET
}

model User {
  id           String   @id @default(cuid())
  name         String
  username     String   @unique
  passwordHash String
  role         UserRole @default(STAFF)
  createdAt    DateTime @default(now())

  accommodationBookings AccommodationBooking[]
  banquetBookings       BanquetBooking[]
  cancellationLogs      CancellationLog[]
  paymentEntries        PaymentEntry[]
  attachments           Attachment[]
}

/**
 * A lightweight, name-searchable customer directory shared across accommodation and banquet
 * booking forms. Bookings still store customerName/phone as plain text (never a hard FK) so
 * staff can always type a name freely; saving a booking auto-upserts a matching row here so
 * the directory grows on its own from real usage, without needing manual data entry.
 */
model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  taxId     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

model Resource {
  id        String       @id @default(cuid())
  name      String
  zone      ResourceZone
  type      ResourceType
  capacity  Int?
  sortOrder Int          @default(0)

  /**
   * Accommodation: standard nightly rate.
   */
  price Decimal? @db.Decimal(10, 2)

  /**
   * Banquet: rate per hour and full-day charter rate.
   */
  hourlyPrice Decimal? @db.Decimal(10, 2)
  dailyPrice  Decimal? @db.Decimal(10, 2)

  /**
   * Banquet: display category (e.g. "VIP เล็ก"), special pricing condition, and main equipment.
   */
  roomType       String?
  priceCondition String?
  equipment      String?

  /**
   * Accommodation only: the room's current physical readiness, set by housekeeping — a
   * single live value per room, not tracked historically per day.
   */
  housekeepingStatus HousekeepingStatus @default(READY)

  accommodationBookings AccommodationBooking[]
  banquetBookings       BanquetBooking[]

  @@index([type, zone, sortOrder])
}

model AccommodationBooking {
  id           String              @id @default(cuid())
  resourceId   String
  resource     Resource            @relation(fields: [resourceId], references: [id])
  customerName String
  phone        String
  source       BookingSource       @default(WALK_IN)
  checkIn      DateTime
  checkOut     DateTime
  guestCount   Int                 @default(1)
  roomPrice    Decimal?            @db.Decimal(10, 2)
  status       AccommodationStatus @default(RESERVED)
  notes        String?

  /**
   * Housekeeping-facing fields, settable by any staff role from the daily grid card.
   */
  needsAdditionalService Boolean @default(false)
  /**
   * Number of times "พักต่อ" has pushed checkOut forward by one night.
   */
  extensionCount         Int     @default(0)

  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  addons                AccommodationAddon[]
  payment               Payment?
  linkedBanquetBookings BanquetBooking[]     @relation("LinkedAccommodation")
  attachments           Attachment[]

  @@index([resourceId, checkIn, checkOut])
}

enum SpecialServiceScope {
  ACCOMMODATION
  BANQUET
}

model SpecialService {
  id        String              @id @default(cuid())
  name      String              @unique
  price     Decimal             @db.Decimal(10, 2)
  scope     SpecialServiceScope @default(ACCOMMODATION)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  addons        AccommodationAddon[]
  banquetAddons BanquetAddon[]
}

model AccommodationAddon {
  id          String               @id @default(cuid())
  bookingId   String
  booking     AccommodationBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  serviceId   String?
  service     SpecialService?      @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  description String?
  quantity    Int                  @default(1)
  price       Decimal              @default(0) @db.Decimal(10, 2)
}

model BanquetAddon {
  id          String          @id @default(cuid())
  bookingId   String
  booking     BanquetBooking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  serviceId   String?
  service     SpecialService? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  description String?
  quantity    Int             @default(1)
  price       Decimal         @default(0) @db.Decimal(10, 2)
}

model BanquetBooking {
  id                   String                 @id @default(cuid())
  resourceId           String
  resource             Resource               @relation(fields: [resourceId], references: [id])
  customerName         String
  phone                String?
  eventDate            DateTime
  startTime            DateTime
  endTime              DateTime
  eventType            BanquetEventType       @default(MEETING)
  headcount            Int                    @default(1)
  foodService          String?
  linkedAccommodations AccommodationBooking[] @relation("LinkedAccommodation")
  status               BanquetStatus          @default(RESERVED)
  notes                String?
  createdById          String?
  createdBy            User?                  @relation(fields: [createdById], references: [id])
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  addons      BanquetAddon[]
  payment     Payment?
  attachments Attachment[]

  @@index([resourceId, eventDate])
}

model CancellationLog {
  id            String      @id @default(cuid())
  bookingType   BookingType
  bookingId     String
  resourceName  String
  customerName  String
  phone         String?
  bookingPeriod String
  reason        String?
  cancelledById String?
  cancelledBy   User?       @relation(fields: [cancelledById], references: [id])
  cancelledAt   DateTime    @default(now())

  @@index([cancelledAt])
}

model Payment {
  id                     String                @id @default(cuid())
  accommodationBookingId String?               @unique
  accommodationBooking   AccommodationBooking? @relation(fields: [accommodationBookingId], references: [id], onDelete: Cascade)
  banquetBookingId       String?               @unique
  banquetBooking         BanquetBooking?       @relation(fields: [banquetBookingId], references: [id], onDelete: Cascade)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  entries PaymentEntry[]
}

/**
 * One recorded payment (a "receipt") toward a booking's net total; a Payment can have many.
 */
model PaymentEntry {
  id            String        @id @default(cuid())
  paymentId     String
  payment       Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  amount        Decimal       @db.Decimal(10, 2)
  method        PaymentMethod @default(CASH)
  paidAt        DateTime
  receivedById  String?
  receivedBy    User?         @relation(fields: [receivedById], references: [id], onDelete: SetNull)
  notes         String?
  receiptNumber String        @unique
  createdAt     DateTime      @default(now())

  @@index([paymentId])
}

/**
 * A file (photo/PDF) attached to a booking — stored in Cloudflare R2, with only the
 * object key and metadata kept here. Belongs to exactly one booking, whichever FK is set.
 */
model Attachment {
  id                     String                @id @default(cuid())
  accommodationBookingId String?
  accommodationBooking   AccommodationBooking? @relation(fields: [accommodationBookingId], references: [id], onDelete: Cascade)
  banquetBookingId       String?
  banquetBooking         BanquetBooking?       @relation(fields: [banquetBookingId], references: [id], onDelete: Cascade)
  key                    String
  fileName               String
  mimeType               String
  size                   Int
  uploadedById           String?
  uploadedBy             User?                 @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt              DateTime              @default(now())

  @@index([accommodationBookingId])
  @@index([banquetBookingId])
}
